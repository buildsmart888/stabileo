{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GO Structural Analysis (Stabileo Desktop)",
  "version": "0.2.0",
  "identifier": "com.buildsmart888.go-structural-analysis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4000",
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GO Structural Analysis | Stabileo AGPL-3.0",
        "width": 1450,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; base-uri 'self'; object-src 'none'; img-src 'self' tauri: asset: data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://stabileo.com; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/NOTICE-AGPL.txt"
    ],
    "shortDescription": "AGPL-3.0 engineering structural analysis desktop"
  }
}
