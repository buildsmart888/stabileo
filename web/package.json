{
  "name": "stabileo-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm": "cd ../engine && wasm-pack build --target web --out-dir ../web/src/lib/wasm --no-opt",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:frontend": "npm run desktop:verify-solver && node scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:smoke": "node --test scripts/desktop-smoke.test.mjs && node scripts/desktop-performance-fixtures.mjs",
    "desktop:verify-solver": "node scripts/check-wasm.mjs && node scripts/verify-wasm-solvers.mjs",
    "desktop:performance-fixtures": "node scripts/desktop-performance-fixtures.mjs",
    "desktop:perf-unit": "vitest run src/lib/viewport3d/__tests__/lod.test.ts src/lib/three/__tests__/elements-batched.test.ts src/lib/three/__tests__/elements-batched-grow.test.ts src/lib/three/__tests__/elements-picking.test.ts src/lib/three/__tests__/nodes-instanced.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.5.0",
    "@types/three": "^0.182.0",
    "svelte": "^5.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "katex": "^0.16.28",
    "lz-string": "^1.5.0",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.9",
    "web-ifc": "^0.0.75",
    "xlsx": "^0.18.5"
  }
}
